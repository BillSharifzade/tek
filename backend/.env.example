# --- tek-api ---
DATABASE_URL=postgres://tek:tek@127.0.0.1:5433/tek
BIND=127.0.0.1:8181
JWT_SECRET=change-me-in-production
# comma separated origins, or * for dev
CORS_ORIGINS=*
FRONTEND_URL=http://127.0.0.1:3010
DB_MAX_CONNECTIONS=32
# integrations (leave empty to mock)
CRM_WEBHOOK_URL=
ONEC_WEBHOOK_URL=
# e-mail (SMTP): smtps://user:pass@smtp.example.com:465 или smtp://user:pass@host:587?tls=required; пусто — письма mock
SMTP_URL=
MAIL_FROM="ТЭК <noreply@tec.tj>"
# общий ящик для заказов / регистраций / заявок клиентов без закреплённого менеджера (иначе — лид-менеджеру)
MANAGER_NOTIFY_EMAIL=
RUST_LOG=info,sqlx=warn,tower_http=info

# --- необязательные (значения по умолчанию для разработки) ---
# APP_ENV=development            # production — строгая проверка настроек (см. README «Продакшн»)
# SEED_DEMO=full                 # full | catalog | off — что заливать в пустую базу (в production по умолчанию off)
# DEMO_STAND=false               # демо-стенд: разрешает SEED_DEMO=full и PAYMENTS_MOCK в production
# PAYMENTS_MOCK=true             # заглушка онлайн-оплаты Алиф / ДС (вне production включена)
# ADMIN_EMAIL= / ADMIN_PASSWORD= # первый администратор, если в базе нет ни одного admin
# TRUST_PROXY=false              # доверять заголовку IP клиента от reverse proxy (в production включено)
# CLIENT_IP_HEADER=x-forwarded-for
# реквизиты продавца в счёте на оплату
# SELLER_NAME= / SELLER_INN= / SELLER_ADDRESS= / SELLER_BANK= / SELLER_ACCOUNT=
