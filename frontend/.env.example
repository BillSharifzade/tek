# --- tek frontend (dev) --- cp .env.example .env.local
# API для браузера (и для сервера, если API_URL не задан)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8181/api/v1
# API для серверного рендера (например, адрес внутри docker-сети); не задан — NEXT_PUBLIC_API_URL
# API_URL=http://tek-api:8181/api/v1
# публичный адрес сайта (sitemap, robots, ссылки)
SITE_URL=http://127.0.0.1:3010
# подпуть сайта на домене, например /tek; пусто — корень (встраивается при сборке)
NEXT_PUBLIC_BASE_PATH=
# ключ Static API Яндекс.Карт (карта на странице «Контакты»); пусто — открытая версия Static API 1.x
NEXT_PUBLIC_YANDEX_MAPS_KEY=
