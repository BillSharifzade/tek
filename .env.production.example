# Скопируйте в .env рядом с docker-compose.prod.yml и заполните. Файл с секретами в git не коммитить.

# публичный адрес сайта (с подпутём, если есть) и его origin
SITE_URL=https://tec.tj
PUBLIC_ORIGIN=https://tec.tj
# подпуть сайта на домене, например /tek; пусто — корень домена (встраивается при сборке образа frontend)
BASE_PATH=

# секреты: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# данные при первом запуске пустой базы: off — ничего (каталог из 1С), catalog — демо-каталог и контент без аккаунтов,
# full — плюс демо-аккаунты и заказы (только с DEMO_STAND=true; пароли сразу сменить: tek-api set-password)
SEED_DEMO=off
DEMO_STAND=false
# первый администратор (создаётся, если в базе нет ни одного admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# интеграции: без адресов события копятся в очереди и уйдут, когда адреса появятся
CRM_WEBHOOK_URL=
ONEC_WEBHOOK_URL=

# реквизиты продавца в счёте на оплату
SELLER_NAME=ООО «Точикэлектрокомплект»
SELLER_INN=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_ACCOUNT=

# за reverse proxy: заголовок с IP клиента (для лимитов по IP); порты на 127.0.0.1 для proxy на хосте
CLIENT_IP_HEADER=x-forwarded-for
API_PORT=18181
WEB_PORT=13010
# внешняя сеть reverse proxy (для deploy/edge-network.override.yml)
EDGE_NETWORK=
